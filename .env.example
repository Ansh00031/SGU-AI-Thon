# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Custom base URL for Ollama, vLLM, Azure, or local OpenAI-compatible endpoints
# For Ollama: http://localhost:11434/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# LLM Model Name (e.g., gpt-4o, gpt-4o-mini, llama3.1:8b, mistral, etc.)
LLM_MODEL=gpt-4o
